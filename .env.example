# === SeniorCare Hub Environment Variables ===

# 1. Supabase Project URL (Dashboard -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Dashboard -> Settings -> API)
# SAFE to use in frontend. Provides basic access controlled by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# === DO NOT ADD SUPABASE_SERVICE_ROLE_KEY HERE ===
# The Service Role key bypasses all security. 
# ONLY use it in Supabase Edge Functions.
